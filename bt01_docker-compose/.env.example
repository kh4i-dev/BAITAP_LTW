# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit .env)
# Nguồn token: Cloudflare Zero Trust -> Networks -> Tunnels -> chọn tunnel -> token

CLOUDFLARE_TOKEN_WEB1=thay_token_tunnel_web1
CLOUDFLARE_TOKEN_WEB2=thay_token_tunnel_web2

# Tài khoản admin Nginx Proxy Manager (giá trị mẫu - tự đổi khi dùng thật)
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=changeme

# MariaDB
